{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/images/:path*", "destination": "https://rorygibbs.com/images/:path*" },
    { "source": "/logos/:path*", "destination": "https://rorygibbs.com/logos/:path*" },
    { "source": "/personal/:path*", "destination": "https://rorygibbs.com/personal/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
